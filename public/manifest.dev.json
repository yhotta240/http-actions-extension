{
  "manifest_version": 3,
  "name": "HTTP Actions - Webページの情報を使ってAPIを呼び出す",
  "short_name": "HTTP Actions",
  "version": "0.1.0",
  "description": "Chromeのコンテキストメニューやポップアップから任意のHTTP Requestを送信できる拡張機能",
  "icons": {
    "48": "icons/icon.png"
  },
  "permissions": [
    "scripting",
    "storage",
    "contextMenus",
    "notifications",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
