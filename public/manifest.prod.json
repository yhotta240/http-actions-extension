{
  "manifest_version": 3,
  "name": "HTTP Actions - HTTPリクエストを登録して実行",
  "short_name": "HTTP Actions",
  "version": "0.3.0",
  "description": "HTTPリクエストをアクションとして登録し，ポップアップや右クリックメニューから実行できるChrome拡張機能",
  "icons": {
    "48": "icons/icon.png"
  },
  "permissions": [
    "scripting",
    "storage",
    "contextMenus",
    "webNavigation",
    "notifications",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
